        <mxCell id="lkcjwSd1ra8fj9H7Ku44-97" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;возвращает &lt;b&gt;authorization code&lt;/b&gt; после успешной авторизации&lt;/font&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="lkcjwSd1ra8fj9H7Ku44-96">
