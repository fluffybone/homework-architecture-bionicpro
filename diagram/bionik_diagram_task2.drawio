        <mxCell id="lkcjwSd1ra8fj9H7Ku44-101" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;выполнения запросов от имени пользователя&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;с использованием &lt;b&gt;access-токена&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="lkcjwSd1ra8fj9H7Ku44-100">
