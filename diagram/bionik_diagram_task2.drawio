        <mxCell id="lkcjwSd1ra8fj9H7Ku44-98" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp;создает для фронтенда сессию и устанавливает ее в виде защищенной httpOnly cookie&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="873.5" y="530" width="270" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lkcjwSd1ra8fj9H7Ku44-99" value="При последующих запросах к API фронтенд отправляет на BFF свою сессионную cookie. BFF, в свою очередь, использует сохраненный access-токен для аутентифицированных запросов к внутреннему API системы BionicPRO" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" vertex="1" parent="1">
